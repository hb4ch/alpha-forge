/* Alpha Forge TUI Theme — dark quant-terminal aesthetic */

Screen {
    background: $background;
}

/* ── Layout ── */

#sidebar {
    width: 28;
    border-right: solid $panel;
    padding: 1 1 0 1;
    background: $surface;
}

#main-area {
    width: 1fr;
}

#conversation {
    height: 2fr;
    border-bottom: solid $panel;
    border-title-color: $text-muted;
    border-title-style: bold;
    padding: 0 1;
}

#bottom-tabs {
    height: 1fr;
}

/* ── Status bar ── */

#status-bar {
    dock: bottom;
    height: 1;
    background: $panel;
    color: $text;
}

/* ── Sidebar sections ── */

#sidebar-banner {
    text-align: center;
    text-style: bold;
    color: $accent;
    padding: 0 0 1 0;
}

#family-section {
    border: solid $panel;
    border-title-color: $accent;
    border-title-style: bold;
    padding: 0 1;
    height: auto;
    margin: 0 0 1 0;
}

#pipeline-section {
    border: solid $panel;
    border-title-color: $accent;
    border-title-style: bold;
    padding: 0 1;
    height: auto;
    margin: 0 0 1 0;
}

#families-section {
    border: solid $panel;
    border-title-color: $accent;
    border-title-style: bold;
    padding: 0 1;
    height: 1fr;
}

/* ── Pipeline steps ── */

.pipeline-step {
    height: 1;
}

.pipeline-step.completed {
    color: $success;
}

.pipeline-step.active {
    color: $warning;
    text-style: bold;
}

.pipeline-step.pending {
    color: $text-muted;
}

/* ── Verdicts ── */

.verdict-approve {
    color: $success;
}

.verdict-approve-constraints {
    color: $warning;
}

.verdict-revise {
    color: #f0883e;
}

.verdict-reject {
    color: $error;
}

/* ── Mode badges ── */

.mode-autopilot {
    background: $primary;
    color: $text;
}

.mode-semi-auto {
    background: #f0883e;
    color: $text;
}

/* ── Strikes ── */

.strike-active {
    color: $error;
}

.strike-inactive {
    color: $text-muted;
}

/* ── Risk levels ── */

.risk-low {
    color: $success;
}

.risk-medium {
    color: $warning;
}

.risk-high {
    color: $error;
}

/* ── Bottom tabs ── */

TabbedContent > ContentSwitcher {
    padding: 1;
}

Tabs {
    background: $surface;
}

Tab {
    color: $text-muted;
    background: $surface;
}

Tab.-active {
    color: $accent;
    text-style: bold;
    background: $surface;
}

Tab:focus {
    color: $accent;
    text-style: bold;
}

Tab:hover {
    color: $text;
}

Underline > .underline--bar {
    color: $accent;
    background: $panel;
}

/* ── Collapsible verdict cards ── */

Collapsible {
    margin: 0 0 1 0;
    padding: 0 1;
}

/* ── DataTable ── */

DataTable > .datatable--header {
    text-style: bold;
    color: $accent;
}

/* ── Focus styling ── */

#conversation:focus-within {
    border-bottom: solid $primary;
}

DataTable:focus {
    border: solid $primary;
}

/* ── Command palette ── */

#command-palette {
    dock: bottom;
    height: auto;
    border: round $accent;
    background: $surface;
    padding: 0 1;
    margin: 0 2;
}

#command-bar {
    height: 1;
}

#command-prefix {
    width: 2;
    color: $accent;
    text-style: bold;
}

#command-input {
    background: $panel;
    color: $text;
    border: none;
}

/* ── Override modal ── */

OverrideModal {
    align: center middle;
}

#override-container {
    width: 70;
    max-height: 30;
    border: double $warning;
    background: $surface;
    padding: 1 2;
}

/* ── Empty states ── */

.empty-state {
    color: $text-muted;
    text-style: italic;
    text-align: center;
    padding: 2;
}
